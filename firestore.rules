rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isLeapYearStr(y) {
      return y.matches('^([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)$');
    }

    function isValidDateKey(d) {
      return d is string
        && d.size() == 10
        && d.matches('^[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && !(d[5:7] in ['04', '06', '09', '11'] && d[8:10] == '31')
        && !(d[5:7] == '02' && d[8:10] in ['30', '31'])
        && !(d[5:7] == '02' && d[8:10] == '29' && !isLeapYearStr(d[0:4]));
    }

    function monthToInt(m) {
      return {
        '01': 1, '02': 2, '03': 3, '04': 4, '05': 5, '06': 6,
        '07': 7, '08': 8, '09': 9, '10': 10, '11': 11, '12': 12
      }[m];
    }

    function dayToInt(day) {
      return {
        '01': 1, '02': 2, '03': 3, '04': 4, '05': 5, '06': 6, '07': 7, '08': 8, '09': 9, '10': 10,
        '11': 11, '12': 12, '13': 13, '14': 14, '15': 15, '16': 16, '17': 17, '18': 18, '19': 19, '20': 20,
        '21': 21, '22': 22, '23': 23, '24': 24, '25': 25, '26': 26, '27': 27, '28': 28, '29': 29, '30': 30,
        '31': 31
      }[day];
    }

    // Allows up to +1 day ahead of UTC request.time to accommodate UTC+14 timezones,
    // while blocking completions further in the future at the rules layer.
    function isNotFarFutureDateKey(d) {
      return timestamp.date(int(d[0:4]), monthToInt(d[5:7]), dayToInt(d[8:10])) <= request.time + duration.value(1, 'd');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProfile(data, userId) {
      return data.uid is string
        && data.uid == userId
        && data.theme is string
        && data.theme in ['dark', 'light', 'system']
        && data.remindersEnabled is bool
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80))
        && (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500000))
        && (!('timezone' in data) || data.timezone == null || (data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 80));
    }

    function isValidHabit(data, userId, habitId) {
      return data.id is string
        && data.id == habitId
        && data.userId is string
        && data.userId == userId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.icon is string
        && data.icon.size() >= 1
        && data.icon.size() <= 64
        && data.sortOrder is int
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 280))
        && (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 500000))
        && (!('reminderTime' in data) || data.reminderTime == null || (data.reminderTime is string && data.reminderTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('archivedAt' in data) || data.archivedAt == null || data.archivedAt is timestamp);
    }

    function isValidCompletion(data, userId, habitId, dateKey) {
      return data.userId is string
        && data.userId == userId
        && data.habitId is string
        && data.habitId == habitId
        && isValidDateKey(data.completionDate)
        && data.completionDate == dateKey
        && isNotFarFutureDateKey(data.completionDate)
        && data.createdAt == request.time;
    }

    // User profile document (PII isolated to owner only)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll(['uid', 'theme', 'remindersEnabled', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'timezone', 'theme', 'remindersEnabled', 'createdAt', 'updatedAt'])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isValidProfile(incoming(), userId);
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'timezone', 'theme', 'remindersEnabled', 'updatedAt']);
      allow delete: if false;

      // Habits owned by userId
      match /habits/{habitId} {
        allow get: if isValidId(userId) && isValidId(habitId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId)
          && isValidId(habitId)
          && isOwner(userId)
          && incoming().keys().hasAll(['id', 'userId', 'name', 'icon', 'sortOrder', 'createdAt'])
          && incoming().keys().hasOnly(['id', 'userId', 'name', 'description', 'icon', 'imageUrl', 'reminderTime', 'sortOrder', 'createdAt', 'archivedAt'])
          && incoming().createdAt == request.time
          && isValidHabit(incoming(), userId, habitId);
        allow update: if isValidId(userId)
          && isValidId(habitId)
          && isOwner(userId)
          && isValidHabit(incoming(), userId, habitId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'icon', 'imageUrl', 'reminderTime', 'sortOrder', 'archivedAt']);
        allow delete: if isValidId(userId) && isValidId(habitId) && isOwner(userId);

        // Completions isolated per habit, keyed by YYYY-MM-DD
        match /completions/{completionDate} {
          allow get: if isValidId(userId) && isValidId(habitId) && isValidDateKey(completionDate) && isOwner(userId);
          allow list: if isValidId(userId) && isValidId(habitId) && isOwner(userId);
          allow create: if isValidId(userId)
            && isValidId(habitId)
            && isValidDateKey(completionDate)
            && isOwner(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/habits/$(habitId))
            && incoming().keys().hasAll(['userId', 'habitId', 'completionDate', 'createdAt'])
            && incoming().keys().hasOnly(['userId', 'habitId', 'completionDate', 'createdAt'])
            && isValidCompletion(incoming(), userId, habitId, completionDate);
          allow update: if false;
          allow delete: if isValidId(userId)
            && isValidId(habitId)
            && isValidDateKey(completionDate)
            && isOwner(userId);
        }
      }
    }
  }
}
