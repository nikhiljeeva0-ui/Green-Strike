{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences and profile metadata for GREENSTRIKE",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 500000
        },
        "timezone": {
          "type": "string",
          "maxLength": 80
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light", "system"]
        },
        "remindersEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "theme", "remindersEnabled", "createdAt", "updatedAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "An individual trackable habit with its own calendar",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 280
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500000
        },
        "reminderTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "sortOrder": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "archivedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "name", "icon", "sortOrder", "createdAt"]
    },
    "HabitCompletion": {
      "title": "HabitCompletion",
      "description": "A single YYYY-MM-DD completion record isolated to one habit",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "habitId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "completionDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "habitId", "completionDate", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile and settings document"
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "User's individual habit documents"
    },
    "/users/{userId}/habits/{habitId}/completions/{completionDate}": {
      "schema": { "$ref": "#/entities/HabitCompletion" },
      "description": "Isolated completion records keyed by YYYY-MM-DD under a single habit"
    }
  }
}
